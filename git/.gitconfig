[user]
	name = alizer-03
	email = 297183473+alizer-03@users.noreply.github.com
[init]
	defaultBranch = main
[color]
	ui = auto
[core]
	excludesfile = ~/.gitignore
    pager = delta
[delta]
    navigate = true
    dark = true
    side-by-side = true
[interactive]
    diffFilter = delta --color-only
[alias]
	st = status
	co = checkout
	a = add
	ap = add -p
	cm = commit -m
	p = push origin HEAD
	pu = pull origin
	d = diff
	graph = log --graph --pretty='%C(yellow)%h %C(cyan)%ar %C(green)%an %C(white)%s' --abbrev-commit