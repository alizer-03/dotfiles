# .editorconfig — règles d'indentation partagées entre éditeurs, au niveau
# du projet plutôt que dans la config propre à chaque éditeur

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Exception cohérente avec l'autocmd BufWritePre de nvim/lua/core/autocmds.lua :
# en Markdown, deux espaces en fin de ligne sont un retour à la ligne volontaire.
[*.md]
trim_trailing_whitespace = false

[*.{c,h}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
